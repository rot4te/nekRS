
#ifdef __okl__

#include "concentric_spheres.oudf"

#endif

void UDF_Setup()
{
  auto mesh = nrs->meshV;

  platform->app->bc->o_usrwrk.resize(1*nrs->fieldOffset);

  std::vector<double> frad(nek::ptr<double>("frad"), nek::ptr<double>("frad") + mesh->Nlocal);
  platform->app->bc->o_usrwrk.copyFrom(frad, mesh->Nlocal, 0 * nrs->fieldOffset);
}

void UDF_ExecuteStep(double time, int tstep)
{
  auto mesh = nrs->meshV;

  if (nrs->checkpointStep) {
    nrs->copyToNek(time, tstep);
    nek::userchk();
  }

  // Nr=1: fully Dirichlet-prescribed boundary temperatures converge by the
  // first solve, same reasoning as parallel_plates_vf -- no flow-radiation
  // feedback loop to amortize here.
  if ((tstep % 1 == 0) and (tstep > 0)) {

    nrs->copyToNek(time, tstep);
    nek::userchk();

    std::vector<double> frad(nek::ptr<double>("frad"), nek::ptr<double>("frad") + mesh->Nlocal);
    platform->app->bc->o_usrwrk.copyFrom(frad, mesh->Nlocal, 0 * nrs->fieldOffset);
  }
}