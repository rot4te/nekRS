      include 'view_factors/view_factors.f'
C-----------------------------------------------------------------------
      subroutine userchk()
      include 'SIZE'
      include 'TOTAL'

      include "view_factors/VIEW_FACTORS"

      character*80  vf_file_name

      real eps,sigma,Cp,rho,U0,T0,f0
      real fac0
      integer option

      if (istep.eq.0)  call rzero(frad(1,1,1,1),ntot)
      call nekrs_registerPtr('frad', frad)

c read view factors computed offline via the nek-vf-case skill's
c compute_view_factors.jl driver (RadiativeViewFactor.jl), not hemicubevf.
c Obstruction is essential here: the outer sphere's concave self-view
c (radiation from one patch of the outer sphere to another, around the
c inner sphere) must be blocked where the inner sphere sits in the line of
c sight -- computed via --obstruction=1 (the inner/hot sphere's Physical
c Surface tag) when this file was generated.
      if (istep.eq.0) then
       vf_file_name = 'vf_concentric_spheres'
       call vf_read_view_factors(vf_file_name)
      endif

c fac0/T0/U0/rho/Cp: no rescaling -- temperatures below are real Kelvin and
c vf_sigma is the real Stefan-Boltzmann constant (see parallel_plates.usr's
c comment on this convention).
       T0 = 1.0
       U0 = 1.0
       rho = 1.0
       Cp = 1.0
       f0 = T0*U0*rho*Cp
       vf_eps = 0.85
       vf_sigma = 5.67e-8
       fac0 = vf_eps*vf_sigma*T0**4.0/f0
c option=1: only relevant to non-wall boundaries, of which this closed
c 2-surface enclosure has none -- kept at 1 for consistency.
       option = 1

       call vf_calculate_radiation_heat_flux(fac0,option)

c report radiative flux on both boundaries (paper Table II: hot, cold)
       call vf_print_radiation_heat_flux(1)
       call vf_print_radiation_heat_flux(2)

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat()
      include 'SIZE'
      include 'TOTAL'

      return
      end
c-----------------------------------------------------------------------
      subroutine useric(ix,iy,iz,eg)
      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'
      integer e,eg

      ux = 0.0
      uy = 0.0
      uz = 0.0
      temp = 750.0

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2()
      include 'SIZE'
      include 'TOTAL'

      integer bc_flag

c Physical Surface tags from concentric_spheres.geo: 1=hot (inner sphere),
c 2=cold (outer sphere). Both are literal solid walls (cbc='W  ').
      do iel=1,nelt
      do ifc=1,2*ndim
         boundaryID(ifc,iel) = 0
         cbc(ifc,iel,1)  = 'E  '
         bc_flag = bc(5,ifc,iel,1)

         if (bc_flag.eq.1) then
            boundaryID(ifc,iel) = 1
            cbc(ifc,iel,1) = 'W  '
         elseif (bc_flag.eq.2) then
            boundaryID(ifc,iel) = 2
            cbc(ifc,iel,1) = 'W  '
         endif

      enddo
      enddo

      return
      end
c-----------------------------------------------------------------------