[GENERAL]
polynomialOrder = 5
stopAt = numSteps
numSteps = 5

timeStepper = tombo2
dt = 1e-2
checkpointInterval = 5

scalars = temperature

[FLUID PRESSURE]
solver = GMRES+flexible+nVector=30+maxIter=1000
initialGuess = projection+nVector=30
smootherType = FourthChebyshev+jac
residualTol = 1e-4

[FLUID VELOCITY]
# boundaryID 1=hot, 2=cold, 3=side (see usrdat2 in parallel_plates.usr).
# All three are literal solid walls -- no forced flow in this case, it only
# exists to drive Nek-VF's radiosity solve with the prescribed wall
# temperatures below (paper Section 4.1). rho/viscosity are placeholders:
# the paper gives no fluid properties for this radiation-only verification
# case, since the interior flow/temperature field is irrelevant to the
# boundary radiosity result.
boundaryTypeMap = wall, wall, wall
rho = 1.0
viscosity = 1e-2
residualTol = 1e-06

[SCALAR TEMPERATURE]
rhoCp = 1000.0
conductivity = 0.01
# All three boundaries are Dirichlet ("udfDirichlet" routes to
# codedFixedValueScalar in parallel_plates.oudf, which sets 1000K/500K/750K
# by boundaryID) -- there is no flux-type boundary in this case, unlike
# tall_cavity_vf_aurora. NOTE: tall_cavity_vf_aurora's own .par uses
# "codedFixedValue" here, which is not a recognized boundaryTypeMap keyword
# in this checked-out NekRS source (src/core/bdry/bdryBase.cpp's
# sBcTextToID/alias table has no such entry -- only "udfDirichlet" and its
# aliases "inlet"/"t"); it may reflect an older/Aurora-specific NekRS
# keyword. Use "udfDirichlet" here to match the currently-checked-out
# source this case would actually be built against.
boundaryTypeMap = udfDirichlet, udfDirichlet, udfDirichlet
residualTol = 1e-06