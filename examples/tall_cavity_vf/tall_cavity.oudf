// Boundary conditions -- converted to this checked-out nekRS source's
// unified udfDirichlet/udfNeumann + isField() convention (the old
// codedFixedValueVelocity/codedFixedValueScalar/codedFixedGradientScalar
// per-field function names and bc->u/v/w, bc->s, bc->flux, bc->idM field
// names are not recognized by this source -- see changelog.md 2026-09-01
// in the main nekRS repo for the same fix applied to the other Nek-VF
// example cases).
void udfDirichlet(bcData *bc)
{
  if (isField("fluid velocity")) {
    bc->uxFluid = 0.0;
    bc->uyFluid = 0.0;
    bc->uzFluid = 0.0;
  } else if (isField("scalar temperature")) {
    bc->sScalar = 100.0;
  }
}

void udfNeumann(bcData *bc)
{
  if (isField("scalar temperature")) {

    dfloat gflux;

    gflux = bc->usrwrk[bc->idxVol + 0 * bc->fieldOffset];  // radiation heat flux from view factor model

    bc->fluxScalar = 0.0 - gflux;
    if (bc->id==1) bc->fluxScalar = 0.5 - gflux;
  }
}

@kernel void fillProp(const dlong Nelements,
                      const dlong uOffset,
                      const dlong sOffset,
                      @ restrict const dfloat *TEMP,
                      @ restrict dfloat *UPROP,
                      @ restrict dfloat *SPROP)
{
  for (dlong e = 0; e < Nelements; ++e; @outer(0)) {
    for (int n = 0; n < p_Np; ++n; @inner(0)) {
    const int id = e * p_Np + n;
    const dfloat rcpTemp = 1.0 / TEMP[id];

    UPROP[id + 0 * uOffset] = 1e-5;      // viscosity
    SPROP[id + 0 * sOffset] = 0.01;      // cond

    UPROP[id + 1 * uOffset] = 1.0;  // rho
    SPROP[id + 1 * sOffset] = 1000.0;  // rhoCp
    }
  }
}
