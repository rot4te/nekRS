
#ifdef __okl__

#include "tall_cavity.oudf"

#endif


// uservp/userf updated for this checked-out nekRS source's current API
// (nrs->cds -> nrs->scalar, nrs->mesh -> nrs->meshV, nrs->o_prop ->
// nrs->fluid->o_prop, nrs->userVelocitySource -> nrs->userSource,
// nrs->o_NLT -> nrs->fluid->o_EXT), following examples/lowMach/lowMach.udf's
// uservp pattern and examples/rbc/rbc.udf's userf/o_EXT buoyancy-source
// pattern (both proven-current, already-building examples in this repo) --
// UNVERIFIED on an actual run: no working buoyancy+radiation example existed
// to cross-check the *combination* against, only each piece separately.
void uservp(double time)
{
  auto mesh = nrs->meshV;

  fillProp(mesh->Nelements,
           nrs->fieldOffset,
           nrs->scalar->fieldOffset(),
           nrs->scalar->o_S,
           nrs->fluid->o_prop,
           nrs->scalar->o_prop);
}


void userf(double time)
{
  auto mesh = nrs->meshV;
  auto o_FUy = nrs->fluid->o_EXT + 1 * nrs->fieldOffset;
  dfloat factor = 0.01;
  platform->linAlg->axpby(mesh->Nlocal, factor, nrs->scalar->o_S, 0.0, o_FUy);
}

void UDF_Setup()
{
auto mesh = nrs->meshV;

  nrs->userSource = &userf;
  nrs->userProperties = &uservp;

  platform->app->bc->o_usrwrk.resize(1*nrs->fieldOffset);

  std::vector<double> frad(nek::ptr<double>("frad"), nek::ptr<double>("frad") + mesh->Nlocal);
  platform->app->bc->o_usrwrk.copyFrom(frad, mesh->Nlocal, 0 * nrs->fieldOffset);


}

void UDF_ExecuteStep(double time, int tstep)
{

auto mesh = nrs->meshV;

    if (nrs->checkpointStep) {
     nrs->copyToNek(time, tstep);
     nek::userchk();
    }


    if ((tstep%100==0)and(tstep > 0)) {

    nrs->copyToNek(time, tstep);
    nek::userchk();
    //nrs->copyFromNek(time);

    std::vector<double> frad(nek::ptr<double>("frad"), nek::ptr<double>("frad") + mesh->Nlocal);
    platform->app->bc->o_usrwrk.copyFrom(frad, mesh->Nlocal, 0 * nrs->fieldOffset);

   }

}
