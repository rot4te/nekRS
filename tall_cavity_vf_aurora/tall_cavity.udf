
#ifdef __okl__

#include "tall_cavity.oudf"

#endif


void uservp(double time)
{
  auto cds = nrs->cds;
  auto mesh = nrs->mesh;

  fillProp(mesh->Nelements,
           nrs->fieldOffset,
           nrs->cds->fieldOffset[0],
           cds->o_S,
           nrs->o_prop,
           cds->o_prop);
}


void userf(double time)
{
  auto mesh = nrs->mesh;
  auto o_T = nrs->cds->o_S + nrs->cds->fieldOffsetScan[0];
  auto o_FUy = nrs->o_NLT + 1 * nrs->fieldOffset;
  dfloat factor = 0.01;
  platform->linAlg->axpby(mesh->Nlocal, factor, o_T, 0.0, o_FUy); 
}

void UDF_Setup()
{
auto mesh = nrs->mesh;

  nrs->userVelocitySource = &userf;
  nrs->userProperties = &uservp;
  
  nrs->o_usrwrk.resize(1*nrs->fieldOffset);
  
  std::vector<double> frad(nek::ptr<double>("frad"), nek::ptr<double>("frad") + mesh->Nlocal);
  nrs->o_usrwrk.copyFrom(frad, mesh->Nlocal, 0 * nrs->fieldOffset);
  
  
}

void UDF_ExecuteStep(double time, int tstep)
{

auto mesh = nrs->mesh;

    if (nrs->checkpointStep) {
     nrs->copyToNek(time, tstep);
     nek::userchk();
    }
	

    if ((tstep%100==0)and(tstep > 0)) {

    nrs->copyToNek(time, tstep);
    nek::userchk();
    //nrs->copyFromNek(time);   

    std::vector<double> frad(nek::ptr<double>("frad"), nek::ptr<double>("frad") + mesh->Nlocal);
    nrs->o_usrwrk.copyFrom(frad, mesh->Nlocal, 0 * nrs->fieldOffset);

   }
	
}
